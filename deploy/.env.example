PORT=8080
DATABASE_URL=postgres://volt:volt@postgres:5432/volt?sslmode=disable

# Google Cloud OAuth client (Phase 1: create the client; see docs/SELF_HOSTING.md).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/auth/google/callback

# No encryption key goes here. Volt derives it from a passphrase you set on
# first run (POST /api/vault/setup) and unlock after every restart (POST
# /api/vault/unlock) — the key lives in server memory only, never on disk,
# so a stolen .env plus a stolen DB dump still isn't enough to read your
# credentials. See docs/decisions/0003-zero-knowledge-vault.md.

# Where the OAuth callback redirects back to after a successful connect.
FRONTEND_URL=http://localhost:3000

# Where the frontend calls the backend API from the browser.
NEXT_PUBLIC_API_URL=http://localhost:8080
