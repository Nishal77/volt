PORT=8080
DATABASE_URL=postgres://volt:volt@postgres:5432/volt?sslmode=disable

# Host-side ports for docker compose — change these if 8080/3000/5433 are
# already taken on your machine. If you change BACKEND_PORT or FRONTEND_PORT,
# also update GOOGLE_REDIRECT_URL, FRONTEND_URL, and NEXT_PUBLIC_API_URL
# below to match, since those are the actual URLs the browser and Google's
# OAuth redirect hit.
BACKEND_PORT=8080
FRONTEND_PORT=3000
POSTGRES_PORT=5433

# Google Cloud OAuth client. Optional here — leave these blank and the
# running app will ask you to paste them in on first run instead (see
# docs/SELF_HOSTING.md). Only set these directly if you'd rather configure
# it before ever opening the app.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/auth/google/callback

# No encryption key goes here. Volt derives it from a passphrase you set on
# first run (POST /api/vault/setup) and unlock after every restart (POST
# /api/vault/unlock) — the key lives in server memory only, never on disk,
# so a stolen .env plus a stolen DB dump still isn't enough to read your
# credentials. See docs/decisions/0003-zero-knowledge-vault.md.

# Where the OAuth callback redirects back to after a successful connect.
FRONTEND_URL=http://localhost:3000

# Where the frontend calls the backend API from the browser.
NEXT_PUBLIC_API_URL=http://localhost:8080
